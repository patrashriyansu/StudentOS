ENVIRONMENT=development
DATABASE_URL=postgresql://user:password@localhost:5432/studentos
SECRET_KEY=replace-with-a-random-production-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-application-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common
FRONTEND_URL=https://studentos-shriyansu.vercel.app
# Resend email API (create a key at https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=StudentOS <noreply@your-verified-domain.com>
SEED_DEMO_DATA=false
